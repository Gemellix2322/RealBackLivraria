FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /app

# Copie o arquivo de projeto e restaure as dependências
COPY *.csproj ./
RUN dotnet restore

# Copie todo o código e publique o aplicativo
COPY . ./
RUN dotnet publish -c Release -o out

# Crie a imagem final
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/out .

# Substitua "SeuProjeto.dll" pelo nome do seu arquivo .dll principal
# (geralmente é o nome do seu projeto)
ENTRYPOINT ["dotnet", "SeuProjeto.dll"]