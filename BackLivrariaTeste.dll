FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /app

# Copie e restaure as dependências
COPY *.csproj ./
RUN dotnet restore

# Copie o resto do código e publique
COPY . ./
RUN dotnet publish -c Release -o out

# Crie a imagem final
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/out ./

# Substitua "SeuProjeto.dll" pelo nome do seu arquivo .dll principal
ENTRYPOINT ["dotnet", "SeuProjeto.dll"]